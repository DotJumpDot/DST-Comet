#!/bin/sh
# dstc — DST Comet launcher (bash). Mirrors bin/dstc.cmd.
# --resume: feed the session id recorded by the TUI to DSH_TUI_RESUME_SESSION.
set -e
: "${NODE_ENV:=production}"
export NODE_ENV
# Fork isolation (2026-10-30): pin comet's OWN state dir so another
# dsh-tui-family fork (DST-Moon) cannot rewrite comet's settings/theme/
# session state — the fork migrates the legacy ~/.dsh-tui once on first use.
: "${DSH_TUI_STATE_DIR:=$HOME/.dsh-tui-comet}"
export DSH_TUI_STATE_DIR
if [ -n "$DSH_TUI_WORKSPACE" ]; then cd "$DSH_TUI_WORKSPACE"; fi

command -v dsh >/dev/null 2>&1 || {
  echo "[dstc] dsh CLI not found. Install: npm install -g @deepseek-ai/dsh" >&2
  exit 1
}

# Rebuild the positional set without --resume (the for list snapshots "$@"
# before `set --` starts replacing it).
set --
for a in "$@"; do
  if [ "$a" = "--resume" ]; then
    if [ -f "$DSH_TUI_STATE_DIR/resume.txt" ]; then
      DSH_TUI_RESUME_SESSION=$(cat "$DSH_TUI_STATE_DIR/resume.txt")
      export DSH_TUI_RESUME_SESSION
    fi
  else
    set -- "$@" "$a"
  fi
done

exec dsh --profile dsh-tui "$@"
