#!/bin/sh
# dstc — DST Comet launcher (bash). Mirrors bin/dstc.cmd.
# --resume: feed the session id recorded by the TUI to DSH_TUI_RESUME_SESSION.
set -e
: "${NODE_ENV:=production}"
export NODE_ENV
if [ -n "$DSH_TUI_WORKSPACE" ]; then cd "$DSH_TUI_WORKSPACE"; fi

command -v dsh >/dev/null 2>&1 || {
  echo "[dstc] dsh CLI not found. Install: npm install -g @deepseek-ai/dsh" >&2
  exit 1
}

# Rebuild the positional set without --resume (the for list snapshots "$@"
# before `set --` starts replacing it).
set --
for a in "$@"; do
  if [ "$a" = "--resume" ]; then
    if [ -f "$HOME/.dsh-tui/resume.txt" ]; then
      DSH_TUI_RESUME_SESSION=$(cat "$HOME/.dsh-tui/resume.txt")
      export DSH_TUI_RESUME_SESSION
    fi
  else
    set -- "$@" "$a"
  fi
done

exec dsh --profile dsh-tui "$@"
