{
  "name": "@deepseek-ai/dsh-experimental-tool-agent-team",
  "description": "Scoped model-facing Agent Teams tools over ctx.agentTeams (DST-Comet fork: team_snapshot, human task queue, lane freeze, per-teammate model routing)",
  "version": "0.2.1-rc.2-comet.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/tool-agent-team"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsdown -c tsdown.config.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --import tsx/esm --test tests/tool-agent-team.spec.ts tests/human-tasks.spec.ts"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-experimental-agent-team": "workspace:*",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2 || 0.2.1-rc.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session": "0.2.1-rc.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.3",
    "@deepseek-ai/dsh-experimental-agent-team": "workspace:*",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3"
  }
}
