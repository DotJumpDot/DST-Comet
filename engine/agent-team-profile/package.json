{
  "name": "@deepseek-ai/dsh-experimental-agent-team-profile",
  "description": "Agent Teams collaboration, tools, and Web UI in one experimental bundle (DST-Comet fork)",
  "version": "0.2.1-rc.2-comet.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/agent-team-profile"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').writeFileSync('lib/index.js', 'export {}\\n')\"",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@deepseek-ai/dsh-experimental-client-ui-agent-team": "0.2.1-rc.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-experimental-agent-team": "0.2.1-rc.2 || 0.2.1-rc.3 || 0.2.1-rc.2-comet.1",
    "@deepseek-ai/dsh-experimental-tool-agent-team": "0.2.1-rc.2 || 0.2.1-rc.3 || 0.2.1-rc.2-comet.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5"
  }
}
